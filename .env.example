# ──────────────────────────────────────────────────────────
# OSINT Tool - Environment Variables Template
# Kopyala: cp .env.example .env
# Sonra ilgili anahtarları doldur.
# ──────────────────────────────────────────────────────────

# ── Zorunlu değil, ama bunlar olmadan bazı modüller atlanır ──

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal — https://virustotal.com (ücretsiz)
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com (ücretsiz)
ABUSEIPDB_API_KEY=

# Hunter.io — https://hunter.io (ücretsiz plan: 25 istek/ay)
HUNTER_API_KEY=

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key (ücretli)
HIBP_API_KEY=

# NumVerify — https://numverify.com (ücretsiz plan: 100 istek/ay)
NUMVERIFY_API_KEY=

# Google Custom Search (ücretsiz: 100 istek/gün)
# API Key: https://console.cloud.google.com → Credentials
GOOGLE_API_KEY=
# CSE ID: https://programmablesearchengine.google.com
GOOGLE_CSE_ID=

# ProxyCurl (LinkedIn scraping) — https://nubela.co/proxycurl
PROXYCURL_API_KEY=

# ── İsteğe Bağlı ─────────────────────────────────────────

# Proxy (tüm istekler bu proxy üzerinden geçer)
# PROXY_URL=http://user:pass@host:port

# Veritabanı yolu
DB_PATH=data/osint.db

# Queue modu (in_process | redis)
OSINT_QUEUE_MODE=in_process
OSINT_REDIS_URL=redis://127.0.0.1:6379/0

# Logging
OSINT_LOG_LEVEL=INFO
OSINT_LOG_FILE=osint_framework.log
OSINT_LOG_CONSOLE=true
OSINT_LOG_ROTATE=true
OSINT_LOG_MAX_BYTES=10485760
OSINT_LOG_BACKUP_COUNT=5
