# ──────────────────────────────────────────────────────────
# OSINT Tool - Environment Variables Template
# Kopyala: cp .env.example .env
# Sonra ilgili anahtarları doldur.
# ──────────────────────────────────────────────────────────

# ── Aktif Entegrasyon Anahtarları (opsiyonel) ──

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key (ücretli)
HIBP_API_KEY=

# NumVerify — https://numverify.com (ücretsiz plan: 100 istek/ay)
NUMVERIFY_API_KEY=

# Google Vision Web Detection (Vision reverse-image URL keşfi için)
GOOGLE_VISION_API_KEY=

# ── İsteğe Bağlı ─────────────────────────────────────────

# Queue modu (in_process | redis)
OSINT_QUEUE_MODE=in_process
OSINT_REDIS_URL=redis://127.0.0.1:6379/0
OSINT_REDIS_PENDING_KEY=osint:queue:scan:pending
OSINT_REDIS_PROCESSING_KEY=osint:queue:scan:processing
OSINT_REDIS_EVENTS_CHANNEL=osint:events:ws
OSINT_QUEUE_RESERVE_TIMEOUT_SECONDS=5
OSINT_QUEUE_WORKER_LEASE_SECONDS=45
OSINT_QUEUE_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# requeue | error
OSINT_QUEUE_STALE_JOB_RECOVERY_ACTION=requeue

# Logging
OSINT_LOG_LEVEL=INFO
OSINT_LOG_FILE=osint_framework.log
OSINT_LOG_CONSOLE=true
OSINT_LOG_ROTATE=true
OSINT_LOG_MAX_BYTES=10485760
OSINT_LOG_BACKUP_COUNT=5

# Vision OSINT (image pipeline)
OSINT_VISION_ENABLED=true
OSINT_VISION_UPLOAD_DIR=osint_framework/data/vision/uploads
OSINT_VISION_MAX_UPLOAD_MB=15
OSINT_VISION_REVERSE_MAX_RESULTS=30
OSINT_VISION_SCRAPER_MAX_PAGES=8
OSINT_VISION_FACE_MIN_CONFIDENCE=0.35
OSINT_VISION_FACE_MIN_SIZE_PX=40
OSINT_VISION_FACE_IOU_THRESHOLD=0.45
OSINT_VISION_FACE_MAX_FACES=10
OSINT_VISION_FACE_ALLOW_FULL_IMAGE_FALLBACK=true
OSINT_VISION_FACE_CROP_PADDING_RATIO=0.18
OSINT_VISION_FACE_CROP_SQUARE=true
OSINT_VISION_ENABLE_EMBEDDING=true
OSINT_VISION_EMBEDDING_MAX_FACES=5
OSINT_VISION_EMBEDDING_FORCE_TOP_FACE=true
OSINT_VISION_ENABLE_SIMILARITY=true
OSINT_VISION_SIMILARITY_MIN_SCORE=0.82
OSINT_VISION_SIMILARITY_TOP_K=5
OSINT_VISION_SIMILARITY_INDEX_PATH=osint_framework/data/vision/face_similarity_index.json
OSINT_VISION_SIMILARITY_MAX_ITEMS=5000

# Maigret integration (username modülü)
OSINT_MAIGRET_ENABLED=true
# OSINT_MAIGRET_COMMAND=python3 -m maigret

# CORS (virgülle ayır)
OSINT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OSINT_CORS_ALLOW_CREDENTIALS=false
OSINT_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
OSINT_CORS_ALLOWED_HEADERS=*

# AI summary (Ollama)
OLLAMA_API_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3

# ── Legacy / şu an çekirdek akışta aktif kullanılmayan placeholderlar ──
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# HUNTER_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# PROXYCURL_API_KEY=
